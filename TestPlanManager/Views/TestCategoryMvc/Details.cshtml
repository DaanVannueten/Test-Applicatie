@model TestPlanManager.Models.TestCategory

@{
        ViewData["Title"] = Model.Name;
}

<div class="container-fluid px-4 py-5">
    <div class="mb-4">
        <a href="@Url.Action("Index","Home", new { sprintId = Model.SprintId })" class="btn back-nav-btn">
            <i class="bi bi-chevron-left me-1"></i> Back to Categories
        </a>
    </div>

    <!-- Header Card -->
    <div class="card mb-4">
        <div class="card-header bg-gradient">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="mb-1"><i class="bi bi-folder2-open me-2"></i>@Model.Name</h2>
                    @if(!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted mb-3">@Model.Description</p>
                    }
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4 g-4">
                <div class="col-md-4">
                    <div class="metric-card">
                        <div class="metric-icon metric-icon-release">
                            <i class="bi bi-calendar3"></i>
                        </div>
                        <div class="metric-content">
                            <small class="text-muted">Release</small>
                            <div class="fw-bold">Release @Model.Sprint?.BuildNr</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-card">
                        <div class="metric-icon metric-icon-department">
                            <i class="bi bi-building"></i>
                        </div>
                        <div class="metric-content">
                            <small class="text-muted">Department</small>
                            <div class="fw-bold">@Model.Department</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-card">
                        <div class="metric-icon metric-icon-status">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="metric-content">
                            <small class="text-muted">Status</small>
                            <div class="fw-bold">@Model.Status</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Progress Section -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Test Progress</h6>
                    <span class="badge text-bg-warning category-progress-badge">@Model.PercentagePassed.ToString("0.##")% Complete</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height: 1.5rem;">
                        <div class="progress-bar bg-gradient" role="progressbar" style="width:@Model.PercentagePassed%;" aria-valuenow="@Model.PercentagePassed" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <span class="small text-muted fw-semibold">@Model.PercentagePassed.ToString("0.##")%</span>
                </div>
            </div>

            <!-- Summary Statistics -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="stat-box stat-passed">
                        <i class="bi bi-check-circle-fill"></i>
                        <div class="stat-number">@Model.Passed</div>
                        <div class="stat-label">Passed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box stat-failed">
                        <i class="bi bi-x-circle-fill"></i>
                        <div class="stat-number">@Model.Failed</div>
                        <div class="stat-label">Failed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box stat-blocked">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div class="stat-number">@Model.Blocked</div>
                        <div class="stat-label">Blocked</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box stat-notstarted">
                        <i class="bi bi-clock-fill"></i>
                        <div class="stat-number">@(Model.TotalTest - Model.Passed - Model.Failed - Model.Blocked - Model.OutOfScope)</div>
                        <div class="stat-label">Not Started</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tests Table Card -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Test Cases (@Model.Tests.Count)</h5>
            @if (User.IsInRole(TestPlanManager.Models.AppRoles.Administrator) || User.IsInRole(TestPlanManager.Models.AppRoles.TestManager))
            {
                <a href="@Url.RouteUrl("test-create", new { testCategoryId = Model.TestCategoryId })" class="btn btn-sm btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Add Test
                </a>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:120px">TEST ID</th>
                            <th>TEST TITLE</th>
                            <th style="width:180px">MODULE</th>
                            <th style="width:140px">TYPE</th>
                            <th style="width:140px">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var t in Model.Tests)
                        {
                            <tr data-href="@Url.RouteUrl("test-edit", new { id = t.TestId })" style="cursor:pointer;" class="table-row-hover">
                                <td><a class="category-test-link fw-bold" href="@Url.RouteUrl("test-edit", new { id = t.TestId })">@($"TC-{t.TestId:D3}")</a></td>
                                <td><span class="fw-500">@t.Name</span></td>
                                <td><small class="text-muted">@Model.Department</small></td>
                                <td><span class="badge @GetBadgeClass(t.ScopeStatus)">@t.ScopeStatus</span></td>
                                <td><span class="badge @GetBadgeClass(t.ExecutionStatus)">@t.ExecutionStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script nonce="@(Context.Items["CspNonce"])">
        // Make test rows clickable. Ignore clicks on actual links so default behaviour remains.
        (function(){
            const rows = document.querySelectorAll('.table.table-hover.mb-0 tbody tr.table-row-hover[data-href]');
            rows.forEach(r => {
                r.addEventListener('click', function(e){
                    if (e.target.closest('a') || e.target.closest('button')) return; // let links/buttons work
                    const href = r.getAttribute('data-href');
                    if (href) window.location = href;
                });
            });
        })();
    </script>
</div>

<style>
    .metric-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--color-bg-secondary);
        border-radius: 0.75rem;
        border: 1px solid var(--color-border-subtle);
    }

    .metric-icon {
        width: 50px;
        height: 50px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #000000;
        font-size: 1.5rem;
        background: #FFF5D6;
    }

    .metric-icon-release {
        background: #FFF5D6;
        color: #000000;
    }

    .metric-icon-department {
        background: #F1F1F1;
        color: var(--color-text-primary);
    }

    .metric-icon-status {
        background: #F5EADF;
        color: #6A503D;
    }

    .stat-box {
        text-align: center;
        padding: 1.5rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

    .stat-box i {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .stat-passed {
        background: #EAF4EE;
        border-left: 4px solid #264F36;
    }

    .stat-passed i {
        color: #264F36;
    }

    .stat-failed {
        background: #FBE8E9;
        border-left: 4px solid #8F0005;
    }

    .stat-failed i {
        color: #8F0005;
    }

    .stat-blocked {
        background: #F5EADF;
        border-left: 4px solid #6A503D;
    }

    .stat-blocked i {
        color: #6A503D;
    }

    .stat-notstarted {
        background: #F1F1F1;
        border-left: 4px solid #6E6E6E;
    }

    .stat-notstarted i {
        color: #6E6E6E;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        margin: 0.5rem 0;
    }

    .stat-passed .stat-number {
        color: #264F36;
    }

    .category-progress-badge {
        background: var(--color-brand-gold) !important;
        color: #000000 !important;
    }

    .category-test-link {
        color: var(--color-text-primary) !important;
        text-decoration: none;
    }

    .category-test-link:hover {
        color: #000000 !important;
        text-decoration: underline;
    }

    .stat-failed .stat-number {
        color: #8F0005;
    }

    .stat-blocked .stat-number {
        color: #6A503D;
    }

    .stat-notstarted .stat-number {
        color: #6E6E6E;
    }

    .stat-label {
        font-size: 0.875rem;
        color: #64748b;
        font-weight: 500;
    }

    .card-header.bg-gradient {
        background: #f8fafc !important;
        color: #1e293b;
        border-bottom: 2px solid #e2e8f0;
    }

    .table-row-hover:hover {
        background-color: #f8fafc;
        transition: background-color 0.2s ease;
    }

    .fw-500 {
        font-weight: 500;
    }
</style>

@functions {
        private string GetBadgeClass(Enum status) =>
                status switch
                {
                        TestPlanManager.Models.ExecutionStatus.Passed or TestPlanManager.Models.ScopeStatus.InScope => "bg-success text-white",
                        TestPlanManager.Models.ExecutionStatus.Failed => "bg-danger text-white",
                        TestPlanManager.Models.ExecutionStatus.Blocked => "bg-warning text-dark",
                        _ => "bg-secondary text-white"
                };
        
        private string GetProductionBadgeClass(string status)
        {
                if (string.IsNullOrEmpty(status)) return "bg-secondary text-white";
                if (status.Contains("Passed")) return "bg-success text-white";
                if (status.Contains("Failed")) return "bg-danger text-white";
                if (status.Contains("Blocked")) return "bg-warning text-dark";
                return "bg-info text-white";
        }
}