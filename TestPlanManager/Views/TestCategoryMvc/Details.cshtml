@model TestPlanManager.Models.TestCategory

@{
        ViewData["Title"] = Model.Name;
}

<a href="@Url.Action("Index","Home")" class="btn btn-link mb-3"><i class="bi bi-chevron-left"></i> Back to Dashboard</a>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between w-100 align-items-start">
            <div>
                <h2 class="mb-1">@Model.Name</h2>
                @if(!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="description">@Model.Description</p>
                }
                <div class="row mt-3">
                    <div class="col-md-4">
                        <span class="icon bi bi-calendar"></span>
                        <small class="text-muted">Release</small>
                        <div><strong>Release @Model.Sprint?.BuildNr</strong></div>
                    </div>
                    <div class="col-md-4">
                        <span class="icon bi bi-person"></span>
                        <small class="text-muted">Owner</small>
                        <div><strong>@Model.Department</strong></div>
                    </div>
                    <div class="col-md-4">
                        <span class="icon bi bi-hourglass-split"></span>
                        <small class="text-muted">Status</small>
                        <div><strong>@Model.Status</strong></div>
                    </div>
                </div>
            </div>
            <div class="ms-3">
                <button class="btn btn-primary btn-lg">Run Tests</button>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="row align-items-center">
            <div class="col-md-9">
                <div class="progress" style="height:1.25rem;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width:@Model.PercentagePassed%;" aria-valuenow="@Model.PercentagePassed" aria-valuemin="0" aria-valuemax="100">
                        &nbsp;
                    </div>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <strong>@Model.PercentagePassed.ToString("0.##")% </strong>
            </div>
        </div>
        <div class="row mt-3 text-muted">
            <div class="col-md-3"><i class="bi bi-check-circle-fill text-success"></i> <strong class="ms-1">@Model.Passed</strong> Passed</div>
            <div class="col-md-3"><i class="bi bi-x-circle-fill text-danger"></i> <strong class="ms-1">@Model.Failed</strong> Failed</div>
            <div class="col-md-3"><i class="bi bi-exclamation-circle-fill text-warning"></i> <strong class="ms-1">@Model.Blocked</strong> Blocked</div>
            <div class="col-md-3"><i class="bi bi-clock-fill text-secondary"></i> <strong class="ms-1">@(Model.TotalTest - Model.Passed - Model.Failed - Model.Blocked - Model.OutOfScope)</strong> Not Started</div>
        </div>
    </div>
</div>

<div class="card">  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Test Cases (@Model.Tests.Count)</h5>
    <a href="@Url.Action("CreateTest", "TestCategoryMvc", new { testCategoryId = Model.TestCategoryId })" class="btn btn-sm btn-success">
      <i class="bi bi-plus-circle"></i> Add Test
    </a>
  </div>    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:120px">TEST ID</th>
                    <th>TEST TITLE</th>
                    <th style="width:180px">MODULE</th>
                    <th style="width:140px">TYPE</th>
                    <th style="width:140px">STATUS</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var t in Model.Tests)
            {
                <tr onclick="window.location='@Url.Action("EditTest", "TestCategoryMvc", new { id = t.TestId })'" style="cursor:pointer;">
                    <td><a class="link-primary" href="@Url.Action("EditTest", "TestCategoryMvc", new { id = t.TestId })">@($"TC-{t.TestId:D3}")</a></td>
                    <td>@t.Name</td>
                    <td>@Model.Department</td>
                    <td><span class="badge @GetBadgeClass(t.ScopeStatus)">@t.ScopeStatus</span></td>
                    <td><span class="badge @GetBadgeClass(t.ExecutionStatus)">@t.ExecutionStatus</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
        private string GetBadgeClass(Enum status) =>
                status switch
                {
                        TestPlanManager.Models.ExecutionStatus.Passed or TestPlanManager.Models.ScopeStatus.InScope => "bg-success text-white",
                        TestPlanManager.Models.ExecutionStatus.Failed => "bg-danger text-white",
                        TestPlanManager.Models.ExecutionStatus.Blocked => "bg-warning text-dark",
                        _ => "bg-secondary text-white"
                };
        
        private string GetProductionBadgeClass(string status)
        {
                if (string.IsNullOrEmpty(status)) return "bg-secondary text-white";
                if (status.Contains("Passed")) return "bg-success text-white";
                if (status.Contains("Failed")) return "bg-danger text-white";
                if (status.Contains("Blocked")) return "bg-warning text-dark";
                return "bg-info text-white";
        }
}