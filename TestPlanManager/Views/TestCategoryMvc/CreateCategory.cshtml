@model TestPlanManager.Models.CreateCategoryInputModel

@{
    ViewData["Title"] = "Create Category";
    var includeTemplatesView = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        && Model.ReturnUrl.Contains("includeTemplates=true", StringComparison.OrdinalIgnoreCase);
    var buildUrl = includeTemplatesView
        ? Url.Action("Index", "Home", new { sprintId = Model.SprintId, includeTemplates = true })
        : Url.Action("Index", "Home", new { sprintId = Model.SprintId });
    var breadcrumbs = new System.Collections.Generic.List<TestPlanManager.Models.BreadcrumbItem>
    {
        new() { Label = "Versions & Templates", Url = Url.Action("Index", "TestPlanVersion") },
        new() { Label = $"{(includeTemplatesView ? "Template" : "Build")} {Model.BuildNr}", Url = buildUrl },
        new() { Label = "Create Category", IsCurrent = true }
    };
}

<div class="container-fluid px-4 py-5">
    <partial name="_Breadcrumbs" model="breadcrumbs" />

    <div class="row mb-4">
        <div class="col-12">
            <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Index", "Home", new { sprintId = Model.SprintId }) : Model.ReturnUrl)" class="btn back-nav-btn">
                <i class="bi bi-chevron-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-folder-plus me-2"></i>Create Test Category</h5>
                        <span class="badge bg-secondary">Build @Model.BuildNr</span>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="CreateCategory" asp-controller="TestCategoryMvc" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SprintId" />
                        <input type="hidden" asp-for="BuildNr" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label">Category Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter category name" required />
                            <span asp-validation-for="Name" class="text-danger d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional category description"></textarea>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label">Department</label>
                                <select asp-for="Department" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<TestPlanManager.Models.Department>()"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Sequence" class="form-label">Order</label>
                                <input asp-for="Sequence" type="number" min="1" class="form-control form-control-lg" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-1"></i> Create Category
                            </button>
                            <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Index", "Home", new { sprintId = Model.SprintId }) : Model.ReturnUrl)" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
