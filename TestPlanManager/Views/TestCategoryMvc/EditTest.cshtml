@model TestPlanManager.Models.Test

@{
    ViewData["Title"] = "Edit Test";
    var canManageTests = User.IsInRole(TestPlanManager.Models.AppRoles.Administrator)
        || User.IsInRole(TestPlanManager.Models.AppRoles.TestManager);
    var isTemplateView = Model.TestCategory?.Sprint?.IsTemplate == true;
    var sprintId = Model.TestCategory?.SprintId ?? 0;
    var buildNr = Model.TestCategory?.Sprint?.BuildNr ?? string.Empty;
    var categoryName = Model.TestCategory?.Name ?? "Category";
    var buildUrl = isTemplateView
        ? Url.Action("Index", "Home", new { sprintId, includeTemplates = true })
        : Url.Action("Index", "Home", new { sprintId });
    var categoryUrl = Url.RouteUrl("test-category-details", new { id = Model.TestCategoryId });
    var breadcrumbs = new System.Collections.Generic.List<TestPlanManager.Models.BreadcrumbItem>
    {
        new() { Label = "Templates", Url = Url.Action("Index", "TestPlanVersion") },
        new() { Label = $"{(isTemplateView ? "Template" : "Build")} {buildNr}", Url = buildUrl },
        new() { Label = categoryName, Url = categoryUrl },
        new() { Label = $"Test TC-{Model.TestId:D3}", IsCurrent = true }
    };
}

<div class="container-fluid px-4 py-5">
    <partial name="_Breadcrumbs" model="breadcrumbs" />

    <div class="row mb-4">
        <div class="col-12">
            <a href="@Url.RouteUrl("test-category-details", new { id = Model.TestCategoryId })" class="btn back-nav-btn">
                <i class="bi bi-chevron-left me-1"></i> Back to Category
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Test</h5>
                            <small class="text-muted mt-1">Test ID: TC-@Model.TestId.ToString("D3")</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="EditTest" asp-controller="TestCategoryMvc" method="post" enctype="multipart/form-data" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TestId" />
                        <input type="hidden" asp-for="TestCategoryId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label"><i class="bi bi-type me-2 text-primary"></i>Name</label>
                            <input asp-for="Name" class="form-control form-control-lg" />
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="ScopeStatus" class="form-label"><i class="bi bi-bullseye me-2 text-primary"></i>Scope Status</label>
                                <select asp-for="ScopeStatus" class="form-select form-select-lg">
                                    <option value="InScope">✓ In Scope</option>
                                    <option value="OutOfScope">✗ Out of Scope</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExecutionStatus" class="form-label"><i class="bi bi-play-circle me-2 text-primary"></i>Execution Status</label>
                                <select asp-for="ExecutionStatus" class="form-select form-select-lg">
                                    <option value="NotRun">Not Run</option>
                                    <option value="Passed">✓ Passed</option>
                                    <option value="Failed">✗ Failed</option>
                                    <option value="Blocked">⊘ Blocked</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label"><i class="bi bi-file-text me-2 text-primary"></i>Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Production" class="form-label"><i class="bi bi-server me-2 text-primary"></i>Production Notes</label>
                            <input asp-for="Production" class="form-control" placeholder="e.g., Fail on FDM1" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Comments" class="form-label"><i class="bi bi-chat-dots me-2 text-primary"></i>Comments</label>
                            <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="mediaFile" class="form-label"><i class="bi bi-images me-2 text-primary"></i>Media Upload (photo/video)</label>
                                <input id="mediaFile" name="mediaFile" class="form-control" type="file" accept="image/*,video/*" />
                            <div class="form-text">Allowed: JPG, PNG, GIF, WEBP, BMP, MP4, WEBM, MOV, AVI. Max 50MB.</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.MediaUrl))
                        {
                            <div class="mb-4 current-media-section">
                                <label class="form-label">Current Media</label>
                                <div class="current-media-card">
                                    @if (Model.MediaUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".avi", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button"
                                                class="media-preview-trigger"
                                                title="Open media in large view"
                                                onclick="openMediaPreview(true, '@Model.MediaUrl')">
                                            <video class="media-preview-content" muted playsinline preload="metadata">
                                                <source src="@Model.MediaUrl" />
                                            </video>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="media-preview-trigger"
                                                title="Open media in large view"
                                                onclick="openMediaPreview(false, '@Model.MediaUrl')">
                                            <img src="@Model.MediaUrl" alt="Test media" class="media-preview-content" />
                                        </button>
                                    }

                                    <div class="mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openMediaPreview(@(Model.MediaUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) || Model.MediaUrl.EndsWith(".avi", StringComparison.OrdinalIgnoreCase) ? "true" : "false"), '@Model.MediaUrl')">
                                            <i class="bi bi-arrows-fullscreen me-1"></i>Open large view
                                        </button>
                                    </div>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="removeMedia" name="removeMedia" value="true" />
                                    <label class="form-check-label" for="removeMedia">Remove current media</label>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-1"></i> Save Changes
                            </button>
                            <a href="@Url.RouteUrl("test-category-details", new { id = Model.TestCategoryId })" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @if (canManageTests)
            {
                <form method="post" action="@Url.Action("DeleteTest", "TestCategoryMvc")" data-confirm-message="Ben je zeker dat je dit wilt verwijderen? Deze test kan niet ongedaan worden gemaakt." class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="testId" value="@Model.TestId" />
                    <input type="hidden" name="testCategoryId" value="@Model.TestCategoryId" />
                    <button type="submit" class="btn btn-danger btn-lg w-100">
                        <i class="bi bi-trash3 me-2"></i> Delete Test
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="mediaPreviewModal" tabindex="-1" aria-labelledby="mediaPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mediaPreviewModalLabel">Media Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center bg-dark">
                <img id="mediaPreviewImage" class="img-fluid d-none" alt="Preview" style="max-height: 75vh; object-fit: contain;" />
                <video id="mediaPreviewVideo" controls class="w-100 d-none" style="max-height: 75vh; object-fit: contain; background: #000;"></video>
            </div>
        </div>
    </div>
</div>

<style>
    .current-media-section {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .current-media-section .form-label {
        margin-bottom: 0;
    }

    .current-media-card {
        display: inline-block;
        padding: 0.6rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        background: #f8fafc;
    }

    .media-preview-trigger {
        border: 0;
        padding: 0;
        margin: 0;
        background: transparent;
        cursor: zoom-in;
        display: block;
        border-radius: 0.6rem;
        overflow: hidden;
    }

    .media-preview-content {
        display: block;
        width: min(420px, 100%);
        max-height: 340px;
        object-fit: contain;
        background: #0f172a;
        border-radius: 0.6rem;
    }

    .media-preview-trigger:focus-visible {
        outline: 3px solid rgba(59, 130, 246, 0.35);
        outline-offset: 2px;
    }
</style>

@section Scripts {
    <script nonce="@(Context.Items["CspNonce"])">
        function openMediaPreview(isVideo, sourceUrl) {
            var modalElement = document.getElementById('mediaPreviewModal');
            var imageElement = document.getElementById('mediaPreviewImage');
            var videoElement = document.getElementById('mediaPreviewVideo');

            if (!modalElement || !imageElement || !videoElement) {
                return;
            }

            if (isVideo) {
                imageElement.classList.add('d-none');
                imageElement.removeAttribute('src');

                videoElement.classList.remove('d-none');
                videoElement.src = sourceUrl;
                videoElement.load();
            } else {
                videoElement.classList.add('d-none');
                videoElement.pause();
                videoElement.removeAttribute('src');

                imageElement.classList.remove('d-none');
                imageElement.src = sourceUrl;
            }

            var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
        }

        document.getElementById('mediaPreviewModal')?.addEventListener('hidden.bs.modal', function () {
            var videoElement = document.getElementById('mediaPreviewVideo');
            if (!videoElement) {
                return;
            }

            videoElement.pause();
            videoElement.removeAttribute('src');
        });
    </script>
}
