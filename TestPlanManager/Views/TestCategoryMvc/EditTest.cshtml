@model TestPlanManager.Models.Test

@{
    ViewData["Title"] = "Edit Test";
}

<div class="container mt-4">
    <a href="@Url.Action("Details", "TestCategoryMvc", new { id = Model.TestCategoryId })" class="btn btn-link mb-3">
        <i class="bi bi-chevron-left"></i> Back to Category
    </a>

    <div class="card">
        <div class="card-body">
            <h3 class="card-title">@Model.Name</h3>
            <p class="text-muted">Test ID: @Model.TestId</p>

            <form asp-action="EditTest" asp-controller="TestCategoryMvc" method="post">
                <input type="hidden" asp-for="TestId" />
                <input type="hidden" asp-for="TestCategoryId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ScopeStatus" class="form-label">Scope Status</label>
                    <select asp-for="ScopeStatus" class="form-select">
                        <option value="InScope">In Scope</option>
                        <option value="OutOfScope">Out of Scope</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ExecutionStatus" class="form-label">Execution Status</label>
                    <select asp-for="ExecutionStatus" class="form-select">
                        <option value="NotRun">Not Run</option>
                        <option value="Passed">Passed</option>
                        <option value="Failed">Failed</option>
                        <option value="Blocked">Blocked</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Production" class="form-label">Production Notes</label>
                    <input asp-for="Production" class="form-control" placeholder="e.g., Fail on FDM1" />
                </div>

                <div class="mb-3">
                    <label asp-for="Comments" class="form-label">Comments</label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="VideoURL" class="form-label">Video URL</label>
                    <input asp-for="VideoURL" class="form-control" type="url" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="@Url.Action("Details", "TestCategoryMvc", new { id = Model.TestCategoryId })" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <form method="post" action="@Url.Action("DeleteTest", "TestCategoryMvc")" onsubmit="return confirm('Are you sure you want to delete this test?');" class="d-inline">
                <input type="hidden" name="testId" value="@Model.TestId" />
                <input type="hidden" name="testCategoryId" value="@Model.TestCategoryId" />
                <button type="submit" class="btn btn-danger">Delete Test</button>
            </form>
        </div>
    </div>
</div>
