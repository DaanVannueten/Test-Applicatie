@model TestPlanManager.Models.Test

@{
    ViewData["Title"] = "Create New Test";
}

<div class="container mt-4">
    <a href="@Url.Action("Details", "TestCategoryMvc", new { id = Model.TestCategoryId })" class="btn btn-link mb-3">
        <i class="bi bi-chevron-left"></i> Back to Category
    </a>

    <div class="card">
        <div class="card-body">
            <h3 class="card-title">Create New Test</h3>

            <form asp-action="CreateTest" asp-controller="TestCategoryMvc" method="post">
                <input type="hidden" asp-for="TestCategoryId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Test Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Test the cash drawer" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ScopeStatus" class="form-label">Scope Status</label>
                    <select asp-for="ScopeStatus" class="form-select">
                        <option value="InScope">In Scope</option>
                        <option value="OutOfScope">Out of Scope</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description *</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe what this test does" required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Comments" class="form-label">Comments</label>
                    <textarea asp-for="Comments" class="form-control" rows="2" placeholder="Optional notes about this test"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="VideoURL" class="form-label">Video URL</label>
                    <input asp-for="VideoURL" class="form-control" type="url" placeholder="https://example.com/video" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Create Test</button>
                    <a href="@Url.Action("Details", "TestCategoryMvc", new { id = Model.TestCategoryId })" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
