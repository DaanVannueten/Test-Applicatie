@model TestPlanManager.Models.UserManagementPageViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h4 class="mb-0">User Management</h4>
    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
        <i class="bi bi-person-plus me-1"></i>Create User
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle user-management-table">
                <thead class="table-light">
                    <tr>
                        <th class="col-email">Email</th>
                        <th class="col-role">Role</th>
                        <th class="col-status">Account Status</th>
                        <th class="col-mfa">MFA</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>
                                    <form asp-action="UpdateRole" asp-controller="UserManagement" method="post" class="role-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@user.UserId" />
                                        <select class="form-select form-select-sm role-select" name="Role">
                                            <option value="@TestPlanManager.Models.AppRoles.Tester" selected="@(user.Role == TestPlanManager.Models.AppRoles.Tester)">@TestPlanManager.Models.AppRoles.Tester</option>
                                            <option value="@TestPlanManager.Models.AppRoles.TestManager" selected="@(user.Role == TestPlanManager.Models.AppRoles.TestManager)">@TestPlanManager.Models.AppRoles.TestManager</option>
                                            <option value="@TestPlanManager.Models.AppRoles.Administrator" selected="@(user.Role == TestPlanManager.Models.AppRoles.Administrator)">@TestPlanManager.Models.AppRoles.Administrator</option>
                                        </select>
                                        <button class="btn btn-outline-primary btn-sm role-save-btn" type="submit">Save</button>
                                    </form>
                                    <div class="form-text role-help" data-role-help></div>
                                </td>
                                <td class="status-cell">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Inactive</span>
                                    }
                                </td>
                                <td class="mfa-cell">
                                    @if (user.IsMfaEnabled)
                                    {
                                        <span class="badge text-bg-success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Not enabled</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="text-muted small current-account-label">Current account</span>
                                    }
                                    else
                                    {
                                        <div class="user-actions">
                                            <form asp-action="ResetMfa" asp-controller="UserManagement" method="post" class="action-form" onsubmit="return confirm('Reset MFA for this user? They will need to set it up again.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="UserId" value="@user.UserId" />
                                                <button class="btn btn-sm btn-outline-secondary action-btn" type="submit" title="Reset MFA setup">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset MFA
                                                </button>
                                            </form>

                                            @if (user.IsActive)
                                            {
                                                <form asp-action="UpdateActive" asp-controller="UserManagement" method="post" class="action-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="UserId" value="@user.UserId" />
                                                    <input type="hidden" name="IsActive" value="false" />
                                                    <button class="btn btn-sm btn-outline-warning action-btn" type="submit" title="Deactivate user">
                                                        <i class="bi bi-lock me-1"></i>Deactivate
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="UpdateActive" asp-controller="UserManagement" method="post" class="action-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="UserId" value="@user.UserId" />
                                                    <input type="hidden" name="IsActive" value="true" />
                                                    <button class="btn btn-sm btn-outline-success action-btn" type="submit" title="Activate user">
                                                        <i class="bi bi-unlock me-1"></i>Activate
                                                    </button>
                                                </form>
                                            }

                                            <form asp-action="DeleteUser" asp-controller="UserManagement" method="post" class="action-form" onsubmit="return confirm('Delete this account permanently?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="UserId" value="@user.UserId" />
                                                <button class="btn btn-sm btn-outline-danger action-btn" type="submit" title="Delete account">
                                                    <i class="bi bi-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .user-management-table {
        width: 100%;
        table-layout: auto;
    }

    .user-management-table th,
    .user-management-table td {
        vertical-align: top;
        padding: 0.95rem 0.9rem;
    }

    .user-management-table thead th {
        text-transform: uppercase;
        font-size: 0.78rem;
        letter-spacing: 0.03em;
        font-weight: 700;
    }

    .col-email { width: 24%; }
    .col-role { width: 30%; }
    .col-status { width: 14%; }
    .col-mfa { width: 12%; }
    .col-actions { width: 20%; }

    .role-form {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
        flex-wrap: wrap;
    }

    .role-select {
        flex: 1 1 auto;
        min-width: 190px;
    }

    .role-save-btn {
        flex: 0 0 auto;
        min-width: 72px;
    }

    .role-help {
        min-height: 2.4em;
        line-height: 1.2;
    }

    .status-cell .badge,
    .mfa-cell .badge,
    .current-account-label {
        margin-top: 0.2rem;
        display: inline-block;
    }

    .user-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        /* Keep buttons on a single line on larger screens; allow horizontal scroll if needed */
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .action-form {
        margin: 0;
        display: inline-flex; /* prevent forms from becoming block-level wrappers */
        align-items: center;
    }

    .action-btn {
        min-width: 92px;
        text-align: center;
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: visible;
        }

        .col-email,
        .col-role,
        .col-status,
        .col-mfa,
        .col-actions {
            width: auto;
        }

        .user-actions {
            flex-wrap: wrap;
            white-space: normal;
        }

        .action-btn {
            width: 100px;
        }
    }
</style>

<script nonce="@(Context.Items["CspNonce"])">
    (function () {
        const roleDescriptions = {
            "Tester": "Can execute test work and update results. Cannot manage users, templates, or admin-only settings.",
            "Test Manager": "Can manage templates and test cycles. Cannot manage users or administrator-only settings.",
            "Administrator": "Full access, including user and role management. Cannot remove the last active administrator account."
        };

        document.querySelectorAll('.role-form').forEach(function (form) {
            const select = form.querySelector('.role-select');
            const help = form.parentElement.querySelector('[data-role-help]');
            if (!select || !help) {
                return;
            }

            const updateHelp = function () {
                help.textContent = roleDescriptions[select.value] || "";
            };

            select.addEventListener('change', updateHelp);
            updateHelp();
        });
    })();
</script>
