@model TestPlanManager.Models.TestPlanVersionPageViewModel

@{
    ViewData["Title"] = "Archived Versions";
    var breadcrumbs = new System.Collections.Generic.List<TestPlanManager.Models.BreadcrumbItem>
    {
        new() { Label = "Templates", Url = Url.Action("Index", "TestPlanVersion") },
        new() { Label = "Archived", IsCurrent = true }
    };
}

<partial name="_Breadcrumbs" model="breadcrumbs" />

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h4 class="mb-0">Archived Test Plan Versions</h4>
    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-controller="TestPlanVersion">
        <i class="bi bi-arrow-left me-1"></i>Back to Active Builds
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Versions.Any())
{
    <div class="card">
        <div class="card-body text-muted">No archived builds found.</div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table dashboard-table">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Type</th>
                    <th>Categories</th>
                    <th>Tests</th>
                    <th>Last Executed</th>
                    <th>Last Worked By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var version in Model.Versions)
            {
                <tr>
                    <td>Build @version.BuildNr</td>
                    <td>
                        @if (version.IsTemplate)
                        {
                            <span class="badge bg-info">Template</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Cycle</span>
                        }
                    </td>
                    <td>@version.CategoryCount</td>
                    <td>@version.TestCount</td>
                    <td>@(version.LastExecutionDate.HasValue ? version.LastExecutionDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                    <td>@(string.IsNullOrWhiteSpace(version.LastWorkedBy) ? "-" : version.LastWorkedBy)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form method="post" asp-action="Restore" asp-controller="TestPlanVersion">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sprintId" value="@version.SprintId" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                            </form>
                            <form method="post" asp-action="Delete" asp-controller="TestPlanVersion" onsubmit="return confirm('This archived version and all underlying tests will be deleted. Continue?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sprintId" value="@version.SprintId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
