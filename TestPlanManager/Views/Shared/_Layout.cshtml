<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Test Plan Manager</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestPlanManager.styles.css" asp-append-version="true" />
    <!-- bootstrap icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body>
    @{
        var canManageUsers = User.Identity?.IsAuthenticated == true
            && User.IsInRole(TestPlanManager.Models.AppRoles.Administrator);

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var hidePrimaryNavigation = currentController == "Account"
            && (currentAction == "Login" || currentAction == "RegisterSelf" || currentAction == "Register");
        var currentPageLabel = currentController switch
        {
            "Home" => "Dashboard",
            "TestPlanVersion" => "Templates",
            "TestCategoryMvc" => "Categories",
            "UserManagement" => "User management",
            "Account" when currentAction == "Login" => "Login",
            "Account" => "Account",
            _ => "Page"
        };
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom sticky-top app-navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center app-brand" asp-area="" asp-controller="TestPlanVersion" asp-action="Index">
                    <img src="~/images/McD_GoldenArches_1235_RGB.png" alt="McDonald's" class="app-brand-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between flex-wrap gap-2" id="mainNavigation">
                    <ul class="navbar-nav flex-grow-1 ms-3 mt-2 mt-lg-0">
                        @if (!hidePrimaryNavigation)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "TestPlanVersion" ? "active fw-semibold" : "")" asp-area="" asp-controller="TestPlanVersion" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
                            </li>
                            @if (canManageUsers)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "UserManagement" ? "active fw-semibold" : "")" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-people me-1"></i>User management</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center mt-2 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link current-user-pill" asp-controller="Account" asp-action="Manage" title="Manage your account">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                    <i class="bi bi-gear ms-2 current-user-pill-cta" aria-hidden="true"></i>
                                </a>
                            </li>
                            @if (User.IsInRole(TestPlanManager.Models.AppRoles.Administrator))
                            {
                                <li class="nav-item me-2">
                                    <span class="badge text-bg-warning">Administrator</span>
                                </li>
                            }
                            else if (User.IsInRole(TestPlanManager.Models.AppRoles.TestManager))
                            {
                                <li class="nav-item me-2">
                                    <span class="badge text-bg-info">Test Manager</span>
                                </li>
                            }
                            else if (User.IsInRole(TestPlanManager.Models.AppRoles.Tester))
                            {
                                <li class="nav-item me-2">
                                    <span class="badge text-bg-secondary">Tester</span>
                                </li>
                            }
                            <li class="nav-item ms-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-main-container">
        <main role="main" class="pb-3 app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted app-footer">
        <div class="container">
            &copy; 2026 - McDonald's Belgium
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
