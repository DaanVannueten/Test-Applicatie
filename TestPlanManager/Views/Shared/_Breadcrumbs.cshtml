@model IEnumerable<TestPlanManager.Models.BreadcrumbItem>

@{
    var items = Model?.ToList() ?? new List<TestPlanManager.Models.BreadcrumbItem>();
}

@if (items.Any())
{
    <nav aria-label="Breadcrumb" class="app-breadcrumb mb-4">
        <ol class="app-breadcrumb-list">
            @* Only render a single back button using the first breadcrumb item if it has a URL. Do not render other breadcrumb pills. *@
            @if (items.Count > 0)
            {
                var first = items[0];
                var isBuildLabel = !string.IsNullOrWhiteSpace(first.Label) && first.Label.IndexOf("Build", System.StringComparison.OrdinalIgnoreCase) >= 0;
                if (!isBuildLabel && !string.IsNullOrWhiteSpace(first.Url))
                {
                    <li class="app-breadcrumb-item">
                        <a href="@first.Url" class="btn back-nav-btn"><i class="bi bi-chevron-left me-1"></i> Back to @first.Label</a>
                    </li>
                }
            }
        </ol>
    </nav>
}