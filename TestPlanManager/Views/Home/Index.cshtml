@model TestPlanManager.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var canManageTests = User.IsInRole(TestPlanManager.Models.AppRoles.Administrator)
        || User.IsInRole(TestPlanManager.Models.AppRoles.TestManager);
    var canManageCycleActions = canManageTests && !Model.SelectedIsTemplate;
    var totalCategories = Model.Categories.Count();
    var completedCategories = Model.Categories.Count(c => c.PercentagePassed >= 100f);
    var selectedLabel = !string.IsNullOrWhiteSpace(Model.SelectedBuildNr)
        ? $"{(Model.SelectedIsTemplate || Model.IncludeTemplatesView ? "Template" : "Build")} {Model.SelectedBuildNr}"
        : "Dashboard";
    var breadcrumbs = new System.Collections.Generic.List<TestPlanManager.Models.BreadcrumbItem>
    {
        new() { Label = "Templates", Url = Url.Action("Index", "TestPlanVersion") },
        new() { Label = selectedLabel, IsCurrent = true }
    };
}

<partial name="_Breadcrumbs" model="breadcrumbs" />

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h4 class="mb-0">Dashboard</h4>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-secondary">Version: @(!string.IsNullOrWhiteSpace(Model.SelectedBuildNr) ? $"Build {Model.SelectedBuildNr}" : "No version")</span>
    </div>
</div>

<div class="dashboard-metrics mb-4">
    <div class="metric-col">
        <div class="card metric-card border-success-subtle">
            <div class="card-body">
                <i class="bi bi-check-circle text-success"></i>
                <div>
                    <h5>Passed %</h5>
                    <h2>@Model.PassedRate.ToString("0.##")%</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card border-danger-subtle">
            <div class="card-body">
                <i class="bi bi-x-circle text-danger"></i>
                <div>
                    <h5>Failed %</h5>
                    <h2>@Model.FailedRate.ToString("0.##")%</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card border-warning-subtle">
            <div class="card-body">
                <i class="bi bi-exclamation-circle text-warning"></i>
                <div>
                    <h5>Blocked %</h5>
                    <h2>@Model.BlockedRate.ToString("0.##")%</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card border-secondary-subtle">
            <div class="card-body">
                <i class="bi bi-slash-circle text-secondary"></i>
                <div>
                    <h5>OOS %</h5>
                    <h2>@Model.OutOfScopeRate.ToString("0.##")%</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-metrics mb-4">
    <div class="metric-col">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-card-checklist"></i>
                <div>
                    <h5>Total Test Cases</h5>
                    <h2>@Model.TotalTestCases</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-play-circle"></i>
                <div>
                    <h5>Tests Executed</h5>
                    <h2>@Model.TestsExecuted</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-bar-chart-line"></i>
                <div>
                    <h5>Completed Categories</h5>
                    <h2>@completedCategories / @totalCategories</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="metric-col">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <h5>Open / Failed</h5>
                    <h2>@Model.OpenOrFailed / @Model.TotalTestCases</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-filters d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div style="min-width: 180px;">
        <select id="statusFilter" class="form-select form-select-sm" style="padding-right: 2.5rem;">
            <option value="">All Statuses</option>
            <option value="Completed">Completed</option>
            <option value="In testing">In testing</option>
            <option value="Not started">Not started</option>
        </select>
    </div>
    <div class="d-flex align-items-center">
        <button id="moreFiltersBtn" class="btn btn-sm btn-outline-secondary me-2" type="button">
            <i class="bi bi-funnel me-1"></i>More Filters
        </button>
        @if (canManageTests && Model.SelectedSprintId.HasValue)
        {
            <form method="get" asp-controller="TestCategoryMvc" asp-action="CreateCategory" class="me-2">
                <input type="hidden" name="sprintId" value="@Model.SelectedSprintId.Value" />
                @if (Model.IncludeTemplatesView)
                {
                    <input type="hidden" name="includeTemplates" value="true" />
                }
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-folder-plus me-1"></i>Create Test Category
                </button>
            </form>
        }
        @if (canManageCycleActions)
        {
            <form method="post" asp-action="ResetAllTests" asp-controller="Home" onsubmit="return confirm('Reset all tests to Not Run? This cannot be undone.');">
                <input type="hidden" name="sprintId" value="@Model.SelectedSprintId" />
                <button type="submit" class="btn btn-sm btn-warning">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Tests
                </button>
            </form>
        }
    </div>
</div>

<!-- Advanced Filters Panel -->
<div id="advancedFiltersPanel" class="card mb-3" style="display: none;">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label for="departmentFilter" class="form-label small">Department</label>
                <select id="departmentFilter" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    <option value="IT">IT</option>
                    <option value="Finance">Finance</option>
                    <option value="Digital">Digital</option>
                    <option value="Ops">Ops</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="releaseFilter" class="form-label small">Release</label>
                <select id="releaseFilter" class="form-select form-select-sm">
                    <option value="">All Releases</option>
                    @foreach(var cat in Model.Categories.GroupBy(c => c.BuildNr))
                    {
                        <option value="@cat.Key">Release @cat.Key</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="progressFilter" class="form-label small">Min Progress (%)</label>
                <input type="number" id="progressFilter" class="form-control form-control-sm" min="0" max="100" placeholder="0">
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-12">
                <button id="resetFiltersBtn" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reset Filters
                </button>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table dashboard-table">
        <thead>
            <tr>
                <th>Feature Name</th>
                <th>Version / Release</th>
                <th>Owner</th>
                <th>Progress</th>
                <th>Test Results</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Categories.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    No categories in this version. Create a version by copying or add categories through the API.
                </td>
            </tr>
        }
        else
        {
            @foreach(var cat in Model.Categories)
            {
                <tr class="status-row" data-status="@cat.Status" 
                    data-department="@cat.Department" 
                    data-release="@cat.BuildNr"
                    data-progress="@cat.PercentagePassed">
                    <td>
                        <div class="feature-title">@cat.Name</div>
                        @if (!string.IsNullOrWhiteSpace(cat.Description))
                        {
                            <div class="feature-subtitle">@cat.Description</div>
                        }
                    </td>
                    <td class="release-cell">Release @cat.BuildNr</td>
                    <td class="owner-cell">
                        <span class="owner-label owner-@cat.Department.ToString().ToLowerInvariant()">@cat.Department Team</span>
                    </td>
                    <td class="progress-cell">
                        <div class="d-flex align-items-center gap-3 progress-wrap">
                            <div class="progress flex-grow-1 dashboard-progress" title="Progress: @cat.PercentagePassed.ToString("0.##")%">
                                <div class="progress-bar" role="progressbar"
                                     style="width: @cat.PercentagePassed%;"
                                     aria-valuenow="@cat.PercentagePassed" aria-valuemin="0" aria-valuemax="100">
                                    <span class="progress-bar-text">@cat.PercentagePassed.ToString("0.##")%</span>
                                </div>
                            </div>
                            <span class="small text-muted fw-semibold">@cat.PercentagePassed.ToString("0.##")%</span>
                        </div>
                    </td>
                    <td class="results-cell">
                        <div class="result-chips">
                            <span class="result-chip result-pass">P @cat.Passed</span>
                            <span class="result-chip result-fail">F @cat.Failed</span>
                            <span class="result-chip result-blocked">B @cat.Blocked</span>
                            <span class="result-chip result-oos">OOS @cat.OutOfScope</span>
                            <span class="result-chip result-nr">NR @cat.NotRun</span>
                        </div>
                    </td>
                    <td class="status-cell">@cat.Status</td>
                    <td class="actions-cell">
                        <a href="@Url.RouteUrl("test-category-details", new { id = cat.TestCategoryId })"
                           class="btn details-link">View Details <i class="bi bi-chevron-right"></i></a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<script>
const moreFiltersBtn = document.getElementById('moreFiltersBtn');
const advancedFiltersPanel = document.getElementById('advancedFiltersPanel');
const statusFilter = document.getElementById('statusFilter');
const departmentFilter = document.getElementById('departmentFilter');
const releaseFilter = document.getElementById('releaseFilter');
const progressFilter = document.getElementById('progressFilter');
const resetFiltersBtn = document.getElementById('resetFiltersBtn');
const rows = document.querySelectorAll('.status-row');

// Toggle advanced filters panel
moreFiltersBtn.addEventListener('click', function() {
    advancedFiltersPanel.style.display = advancedFiltersPanel.style.display === 'none' ? 'block' : 'none';
});

// Apply all filters
function applyFilters() {
    const selectedStatus = statusFilter.value;
    const selectedDepartment = departmentFilter.value;
    const selectedRelease = releaseFilter.value;
    const minProgress = parseInt(progressFilter.value) || 0;
    
    rows.forEach(row => {
        const rowStatus = row.dataset.status;
        const rowDepartment = row.dataset.department;
        const rowRelease = row.dataset.release;
        const rowProgress = parseFloat(row.dataset.progress);
        
        const statusMatch = selectedStatus === '' || rowStatus === selectedStatus;
        const departmentMatch = selectedDepartment === '' || rowDepartment === selectedDepartment;
        const releaseMatch = selectedRelease === '' || rowRelease === selectedRelease;
        const progressMatch = rowProgress >= minProgress;
        
        if (statusMatch && departmentMatch && releaseMatch && progressMatch) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

// Event listeners for filters
statusFilter.addEventListener('change', applyFilters);
departmentFilter.addEventListener('change', applyFilters);
releaseFilter.addEventListener('change', applyFilters);
progressFilter.addEventListener('input', applyFilters);

// Reset filters
resetFiltersBtn.addEventListener('click', function() {
    statusFilter.value = '';
    departmentFilter.value = '';
    releaseFilter.value = '';
    progressFilter.value = '';
    applyFilters();
    advancedFiltersPanel.style.display = 'none';
});
</script>

    <!--
        Dashboard design reference image (replace with your own screenshots if needed):
        <img src="/images/dashboard-screenshot.png" alt="Dashboard design" class="img-fluid mt-3" />
    -->

