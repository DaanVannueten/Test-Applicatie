@model TestPlanManager.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-card-checklist"></i>
                <div>
                    <h5>Total Test Cases</h5>
                    <h2>@Model.Categories.Sum(m => m.TotalTest)</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-play-circle"></i>
                <div>
                    <h5>Tests Executed Today</h5>
                    <h2>@Model.Categories.Sum(m => m.Passed + m.Failed + m.Blocked + m.OutOfScope)</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-bar-chart-line"></i>
                <div>
                    <h5>Overall Pass Rate</h5>
                    <h2>@(Model.Categories.Any() ? Model.Categories.Average(m => m.PercentagePassed).ToString("0.##") + "%" : "0%")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card metric-card">
            <div class="card-body">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <h5>Open / Failed</h5>
                    <h2>@Model.Categories.Sum(m => m.Failed + m.Blocked) / @Model.Categories.Sum(m => m.TotalTest)</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-filters d-flex justify-content-between align-items-center">
    <div>
        <select class="form-select form-select-sm">
            <option selected>All Statuses</option>
            <option>Completed</option>
            <option>In testing</option>
            <option>Not started</option>
        </select>
    </div>
    <div>
        <button class="btn btn-sm btn-outline-secondary">More Filters</button>
    </div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Feature Name</th>
            <th>Release</th>
            <th>Owner</th>
            <th>Progress</th>
            <th>Test Results</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var cat in Model.Categories)
    {
        <tr>
            <td>@cat.Name</td>
            <td>@cat.BuildNr</td>
            <td>@cat.Department</td>
            <td>
                <div class="progress">
                    <div class="progress-bar" role="progressbar"
                         style="width: @cat.PercentagePassed%;"
                         aria-valuenow="@cat.PercentagePassed" aria-valuemin="0" aria-valuemax="100">
                        @cat.PercentagePassed.ToString("0.##")%
                    </div>
                </div>
            </td>
            <td>
                P @cat.Passed / F @cat.Failed / B @cat.Blocked / OOS @cat.OutOfScope / NR @cat.NotRun
            </td>
            <td>@cat.Status</td>
            <td>
                <a href="@Url.Action("Details", "TestCategory", new { id = cat.TestCategoryId })"
                   class="btn btn-sm btn-primary">View Details &gt;</a>
            </td>
        </tr>
    }
    </tbody>
</table>
    <!--
        Dashboard design reference image (replace with your own screenshots if needed):
        <img src="/images/dashboard-screenshot.png" alt="Dashboard design" class="img-fluid mt-3" />
    -->