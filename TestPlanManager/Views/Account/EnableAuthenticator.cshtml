@model TestPlanManager.Models.EnableAuthenticatorViewModel
@{
    ViewData["Title"] = "Enable MFA";
}

<div class="auth-shell">
    <div class="auth-header mt-3 mb-3">
        <h4 class="mb-1">Enable Multi-Factor Authentication</h4>
        <p class="text-muted mb-0">Use an authenticator app such as Microsoft Authenticator or Google Authenticator.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card auth-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-phone me-2"></i>Authenticator setup</h5>
                </div>
                <div class="card-body">
                    <ol class="mb-3">
                        <li>Open your authenticator app.</li>
                        <li>Scan this QR code in your authenticator app.</li>
                    </ol>

                    <div class="text-center mb-3">
                        <img src="@Model.QrCodeImageDataUrl" alt="MFA QR code" class="img-fluid border rounded p-2 bg-white" style="max-width: 260px;" />
                    </div>

                    <p class="small text-muted">If scanning fails, add the account manually with this key:</p>

                    <div class="alert alert-secondary" role="alert">
                        <strong>@Model.SharedKey</strong>
                    </div>

                    <form asp-action="EnableAuthenticator" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" placeholder="123456" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Enable MFA</button>
                        <a asp-action="Manage" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
