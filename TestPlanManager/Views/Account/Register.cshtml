@model TestPlanManager.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Create user</h1>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" maxlength="128" spellcheck="false" autocapitalize="off" autocorrect="off" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" maxlength="128" spellcheck="false" autocapitalize="off" autocorrect="off" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Role</label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="@TestPlanManager.Models.AppRoles.Tester">@TestPlanManager.Models.AppRoles.Tester</option>
                            <option value="@TestPlanManager.Models.AppRoles.TestManager">@TestPlanManager.Models.AppRoles.TestManager</option>
                            <option value="@TestPlanManager.Models.AppRoles.Administrator">@TestPlanManager.Models.AppRoles.Administrator</option>
                        </select>
                        <div class="form-text" id="roleHelpText"></div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create User</button>
                </form>

                <p class="mt-3 mb-0 small text-muted">
                    Return to
                    <a asp-controller="UserManagement" asp-action="Index">User Management</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(Context.Items["CspNonce"])">
        (function () {
            const roleDescriptions = {
                "Tester": "Can execute test work and update results. Cannot manage users, templates, or admin-only settings.",
                "Test Manager": "Can manage templates and test cycles. Cannot manage users or administrator-only settings.",
                "Administrator": "Full access, including user and role management. Cannot remove the last active administrator account."
            };

            const roleSelect = document.getElementById('roleSelect');
            const roleHelpText = document.getElementById('roleHelpText');
            if (!roleSelect || !roleHelpText) {
                return;
            }

            const updateRoleHelp = function () {
                roleHelpText.textContent = roleDescriptions[roleSelect.value] || "";
            };

            roleSelect.addEventListener('change', updateRoleHelp);
            updateRoleHelp();
        })();
    </script>
}
