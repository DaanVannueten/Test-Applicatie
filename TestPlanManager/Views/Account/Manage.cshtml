@model TestPlanManager.Models.ManageAccountPageViewModel
@{
    ViewData["Title"] = "My Account";
}

<div class="auth-shell">
    @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success mt-3" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
    }

    <div class="auth-header mt-3 mb-3">
        <h4 class="mb-1">My Account</h4>
        <p class="text-muted mb-0">Update your own email address and password.</p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card auth-card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-envelope me-2"></i>Change Email</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2 small text-muted">Current email: @Model.CurrentEmail</div>

                    <form asp-action="UpdateEmail" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="UpdateEmail.NewEmail" class="form-label"></label>
                            <input asp-for="UpdateEmail.NewEmail" class="form-control" autocomplete="email" />
                            <span asp-validation-for="UpdateEmail.NewEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UpdateEmail.CurrentPassword" class="form-label"></label>
                            <input asp-for="UpdateEmail.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                            <span asp-validation-for="UpdateEmail.CurrentPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Save Email</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card auth-card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Change Password</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Save Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-lg-6">
            <div class="card auth-card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-phone me-2"></i>Multi-Factor Authentication</h5>
                </div>
                <div class="card-body">
                    @if (Model.IsTwoFactorEnabled)
                    {
                        <div class="alert alert-success" role="alert">
                            MFA is enabled.
                        </div>
                        <p class="small text-muted">Recovery codes remaining: @Model.RecoveryCodesLeft</p>

                        <form asp-action="RegenerateRecoveryCodes" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-primary w-100">Generate New Recovery Codes</button>
                        </form>

                        <form asp-action="DisableAuthenticator" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">Disable MFA</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            MFA is not enabled yet.
                        </div>
                        <a asp-action="EnableAuthenticator" class="btn btn-primary w-100">Enable MFA</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
